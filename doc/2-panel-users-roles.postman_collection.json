{
  "info": {
    "name": "Tahlil Users and Roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use auth collection first and the cookie jar. No origin configuration. Credentials and files are placeholders; never export live cookies/passwords."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1/admin",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "<csrf-token>",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "<user-id>",
      "type": "string"
    },
    {
      "key": "role_id",
      "value": "<role-id>",
      "type": "string"
    },
    {
      "key": "expected_version",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users?page=1&per_page=10"
      }
    },
    {
      "name": "Get user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}"
      }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"<username>\",\n  \"name\": \"Example Editor\",\n  \"email\": \"editor@example.test\",\n  \"password\": \"<private-password>\",\n  \"role_id\": {{role_id}},\n  \"is_active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update user",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{expected_version}},\n  \"name\": \"Updated Editor\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}?expected_version={{expected_version}}"
      }
    },
    {
      "name": "List all roles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/roles"
      }
    },
    {
      "name": "Get role",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/roles/{{role_id}}"
      }
    },
    {
      "name": "Create role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/roles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Example role\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Rename role",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/roles/{{role_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{expected_version}},\n  \"name\": \"Renamed role\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete role and clear assignments",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/roles/{{role_id}}?expected_version={{expected_version}}"
      }
    }
  ]
}
